# Copy to .env (never commit it) or export these before running the app.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<options>
MAIL_USERNAME=your-address@gmail.com
MAIL_PASSWORD=your-gmail-app-password
CONTACT_EMAIL=where-contact-messages-go@example.com
FIREBASE_CREDENTIALS_PATH=/absolute/path/to/firebase-service-account.json
FIREBASE_BUCKET=your-project.appspot.com
